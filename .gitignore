__pycache__/
*.pyc
docs/_build/

# Ignore everything inside calculations/ ...
calculations/**
# ... but let Git look inside subdirectories
!calculations/**/

# Track these automatically, wherever they are (FHI-aims, Gaussian, scripts)
!calculations/**/control.in
!calculations/**/geometry.in
!calculations/**/geometry.in.next_step
!calculations/**/aims.out
!calculations/**/*.sh
!calculations/**/*.com
!calculations/**/*.xyz
!calculations/**/massweighted_Hessian.*.dat
!calculations/**/*.py
!calculations/**/readme.md

# Track these automatically, wherever they are (VASP)
!calculations/**/INCAR
!calculations/**/POSCAR*
!calculations/**/KPOINTS
!calculations/**/CONTCAR*
!calculations/**/OSZICAR

# Never track the per-point/per-mode runs (thousands of files)
calculations/**/ters1d/**
calculations/**/ters2d/**
calculations/**/nmodes/**
calculations/**/1dscan*/**
calculations/**/2dscan*/**
calculations/**/job_launchers/**

# ...but curated folders always win over the exclusions above
!calculations/**/inputs/**/
!calculations/**/inputs/**
!calculations/**/outputs/**/
!calculations/**/outputs/**

# Never tracked anywhere, not even in curated folders
calculations/**/*.png
calculations/**/POTCAR
calculations/**/WAVECAR
calculations/**/CHG
calculations/**/CHGCAR
calculations/**/LOCPOT
calculations/**/PROCAR
calculations/**/OUTCAR
calculations/**/vasprun.xml
