__pycache__/
*.pyc
docs/_build/

# Ignore everything inside calculations/ ...
calculations/**
!calculations/**/

# Curated folders: track everything placed here by hand
!calculations/**/inputs/**
!calculations/**/outputs/**

# Track these automatically, wherever they are
!calculations/**/control.in
!calculations/**/geometry.in
!calculations/**/geometry.in.next_step
!calculations/**/aims.out
!calculations/**/*.sh
!calculations/**/*.com
!calculations/**/*.xyz
!calculations/**/massweighted_Hessian.*.dat
!calculations/**/*.py
!calculations/**/readme.md
calculations/**/*.png

# Never track the per-point/per-mode runs (thousands of files)
calculations/**/ters2d/**
calculations/**/ters1d/**
calculations/**/nmodes/**
calculations/**/1dscan*/**
calculations/**/2dscan*/**
calculations/**/job_launchers/**

# VASP inputs and small outputs
!calculations/**/INCAR
!calculations/**/POSCAR*
!calculations/**/KPOINTS
!calculations/**/CONTCAR*
!calculations/**/OSZICAR

# VASP: never track pseudopotentials or large data
calculations/**/POTCAR
calculations/**/WAVECAR
calculations/**/CHG
calculations/**/CHGCAR
calculations/**/LOCPOT
calculations/**/PROCAR
calculations/**/OUTCAR
calculations/**/vasprun.xml
